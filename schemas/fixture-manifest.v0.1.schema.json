{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/MichaelWave369/PhiPress/blob/main/schemas/fixture-manifest.v0.1.schema.json",
  "title":"PhiPress Research Fixture Manifest v0.1",
  "description":"Versioned research descriptor, NOT a safety certification, actuator permission, or physical interface drawing.",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","fixtureId","displayName","envelopeMm","mount","allowedModes","candidateMaxTemperatureC","materialScope","notes","validatedClaims"],
  "properties":{
    "contractVersion":{"const":"phipress.fixture-manifest.v0.1"},
    "fixtureId":{"enum":["shirt","hat","shoe"]},
    "displayName":{"type":"string","minLength":1,"maxLength":100},
    "envelopeMm":{"type":"object","additionalProperties":false,
      "required":["width","depth","height"],
      "properties":{"width":{"type":"number","exclusiveMinimum":0},"depth":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}}},
    "mount":{"type":"string","minLength":1},
    "allowedModes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["watch","refresh","wet","finish","cleanFinish"]}},
    "candidateMaxTemperatureC":{"type":"number","minimum":10,"maximum":80},
    "materialScope":{"type":"string","minLength":1},
    "notes":{"type":"string"},
    "validatedClaims":{"type":"array","maxItems":0}
  }
}
